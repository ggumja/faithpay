# ============================================================
# SoulPay 환경변수 템플릿 (프로덕션 배포 참고용)
# ============================================================
# 이 파일은 예시 파일입니다. 실제 값은 Vercel / Cloudflare 대시보드의
# Environment Variables에 직접 입력하세요. 절대 실제 키를 여기에 커밋하지 마세요.
#
# 로컬 개발용: .env.local 파일을 별도로 생성하세요 (.gitignore 처리됨)
# ============================================================

# [필수] Supabase 프로젝트 식별자
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# [필수] Supabase 공개 Anon Key (브라우저에 노출됨 — RLS 정책 필수 적용)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ----------------------------------------------------------
# [선택] 포털 URL 커스텀 오버라이드
# 기본적으로 domainUtils.ts가 현재 접속 도메인을 보고 자동 판별합니다.
#   - pay.soulpay.kr 접속 시 → https://admin.soulpay.kr 자동 반환
#   - admin.soulpay.kr 접속 시 → https://pay.soulpay.kr 자동 반환
# 아래 변수는 자동 판별 URL을 강제 오버라이드할 때만 설정하세요.
# ----------------------------------------------------------

# VITE_ADMIN_URL=https://admin.soulpay.kr  # 관리자 포털 (보통 설정 불필요)
# VITE_PAY_URL=https://pay.soulpay.kr      # 결제 포털 (보통 설정 불필요)

# ----------------------------------------------------------
# 도메인별 배포 정보 (참고)
# ----------------------------------------------------------
# 홈페이지  : https://www.soulpay.kr  (랜딩 페이지)
# 결제 포털 : https://pay.soulpay.kr  (신도/기부자 결제 화면)
# 관리자    : https://admin.soulpay.kr (단체 관리자 포털)
# 파트너    : https://partner.soulpay.kr (영업 파트너 포털)
# 운영자    : https://ops.soulpay.kr  (시스템 운영자)
# 개발/테스트: https://dev.soulpay.kr (스테이징 환경)
# ----------------------------------------------------------
